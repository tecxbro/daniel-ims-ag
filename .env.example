# ---- Convex ----
# Get these by running: npx convex dev
# Convex will create a project and auto-populate your .env.local.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# Optional server-only override. Leave commented for local Vite dev; the server
# falls back to VITE_CONVEX_URL, and Convex CLI warns if both active URL vars exist.
# CONVEX_URL=

# ---- Photon Spectrum (iMessage bridge) ----
# Create a project at https://app.photon.codes and copy PROJECT_ID + SECRET_KEY
# from project settings. Photon Spectrum uses the SDK message stream, so no
# inbound iMessage webhook URL is required.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Optional. Daniel coding workspaces cache Photon docs into the Photon skill
# only when Codex needs them.
PHOTON_LLMS_URL=

# ---- Agent runtime ----
# claude = Claude Agent SDK / Claude Code path. codex = local `codex app-server`
# path using the ChatGPT/Codex account from `codex login`.
DANIEL_RUNTIME=claude

# ---- Claude model ----
# Uses your Claude Code subscription automatically — no separate API key needed.
# Override with ANTHROPIC_API_KEY if you want to bypass the subscription.
# This is the *fallback*; runtime overrides set via the iMessage set_model tool
# (stored in the Convex `settings` table) take precedence.
DANIEL_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=

# ---- Codex model ----
# Used when DANIEL_RUNTIME=codex or the runtime setting is switched to Codex.
# Requires `codex login` on the host. DANIEL_CODEX_AUTH_HOME can point at another
# Codex home containing auth.json if needed.
DANIEL_CODEX_MODEL=gpt-5.5
DANIEL_CODEX_REASONING_EFFORT=medium
# DANIEL_CODEX_AUTH_HOME=
# Optional provider-specific models for proactive classification and memory
# consolidation. Defaults are selected by the runtime when left blank.
# DANIEL_CLASSIFIER_MODEL=
# DANIEL_CODEX_CLASSIFIER_MODEL=
# DANIEL_ADVERSARY_MODEL=
# DANIEL_CODEX_ADVERSARY_MODEL=
# Local workspaces created by spawn_coding_agent.
# DANIEL_PROJECTS_ROOT=~/daniel-projects

# ---- Local browser use ----
# Patchright-backed Chrome profile for login-required services, visual browser
# workflows, and bot-wall-sensitive sites. Debug UI settings stored in Convex
# take precedence over these fallbacks. Off by default; enable in Settings
# before agents can see or use the local browser integration.
# DANIEL_BROWSER_ENABLED=false
# DANIEL_BROWSER_PROFILE_DIR=~/.daniel/browser-profile
# DANIEL_BROWSER_SHOW_UI=true
# DANIEL_BROWSER_LOGIN_HANDOFF=false
# DANIEL_BROWSER_START_URL=
# DANIEL_BROWSER_CHANNEL=chrome
# DANIEL_BROWSER_EXECUTABLE_PATH=
# DANIEL_BROWSER_EXTRA_ARGS=

# ---- Proactive email surfacing ----
# Notices use the primary SMS conversation paired in the local dashboard.
# Set to "false" to skip auto-registering the Composio webhook URL on each
# `npm run dev`. Use when you want to manage the subscription manually.
# COMPOSIO_AUTO_WEBHOOK=

# ---- Upgrade notifications ----
# On `npm run dev`, Daniel checks your `upstream` remote for new commits and
# prints a banner with the commit count + a reminder to run `/upgrade-daniel`.
# Set to `false` to silence the check entirely.
# DANIEL_UPSTREAM_CHECK=true

# ---- Changelog source (optional) ----
# Override only for a custom repository or release branch. By default Daniel
# reads the current Git origin and falls back to the canonical repository.
# DANIEL_GITHUB_REPO=tecxbro/daniel-ims-ag
# DANIEL_GITHUB_BRANCH=main
# GITHUB_TOKEN=

# ---- SuperMemory ----
SUPERMEMORY_API_KEY=

# Server-only stable secret for private identifiers. `npm run setup` generates
# this automatically on first setup and never replaces a persisted identity.
DANIEL_MEMORY_ID_SALT=

# Timeout for profile/search requests on the user-facing path.
DANIEL_SUPERMEMORY_TIMEOUT_MS=1200

# Search configuration.
DANIEL_SUPERMEMORY_THRESHOLD=0.60
DANIEL_SUPERMEMORY_SEARCH_LIMIT=8

# dynamic for ordinary conversation ingestion.
DANIEL_SUPERMEMORY_DREAMING=dynamic


# ---- Server ----
PORT=3456

# Public URL for your server.
# - Leave as http://localhost:3456 if you're using free ngrok (URL changes each restart).
# - Set to your stable public URL (e.g. https://daniel.mydomain.com) if you use
#   Cloudflare Tunnel, a Caddy server, or any other tunnel with a fixed URL —
#   `npm run dev` will then skip ngrok.
PUBLIC_URL=http://localhost:3456

# Optional: ngrok RESERVED domain (paid plan). Example: "daniel.ngrok.app".
# When set, `npm run dev` launches ngrok with --domain=$NGROK_DOMAIN so your
# public URL stays the same across restarts.
# NGROK_DOMAIN=

# Photon Spectrum iMessage does not need a public tunnel. PUBLIC_URL/ngrok are
# still used for Composio proactive webhooks when COMPOSIO_API_KEY is set.

# ---- Composio (1000+ integrations, zero-code) ----
# Get an API key at https://app.composio.dev/developers.
# Once set, connect toolkits (Gmail, Slack, GitHub, Linear, …) from the
# Debug UI's Connections tab. Each connected toolkit becomes available to
# the agent via spawn_agent(integrations: [...]).
COMPOSIO_API_KEY=

# Optional: stable user id Composio keys connections under. Defaults to
# "daniel-default". Override only if you already manage Composio sessions
# elsewhere and want Daniel to reuse that user.
# COMPOSIO_USER_ID=

# --- Image retention (optional) ---
# Days to keep iMessage-received image bytes. Images referenced by a
# memory record are kept indefinitely regardless of this setting.
# Set to 0 to disable cleanup (debug only).
DANIEL_IMAGE_RETENTION_DAYS=3
DANIEL_IMAGE_CLEANUP_INTERVAL_MS=43200000
